# Copy to .env and adjust as needed. All variables use the RAG_ prefix.

# Ollama connection
RAG_OLLAMA_BASE_URL=http://localhost:11434
RAG_LLM_MODEL=llama3.1
RAG_EMBEDDING_MODEL=nomic-embed-text

# Generation
RAG_TEMPERATURE=0.1
RAG_NUM_CTX=4096

# Retrieval / chunking
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=4

# Collection / API
RAG_COLLECTION_NAME=knowledge_base
RAG_API_HOST=0.0.0.0
RAG_API_PORT=8000
